# Nightly backup of data/ (audit log = the system of record) and data-lab/
# (the separate paper accounts, PAPER PUSH 2026-10-09): an on-box tarball,
# 14-day retention, in /var/backups/agentic.
# Off-box: DigitalOcean Droplet Backups, enabled by the human in the control
# panel (human ruling 2026-11-04). It replaces the encrypted Spaces push of the
# 2026-09-02 ruling, which was never configured: its second ExecStart
# (/usr/local/bin/agentic-push-backup) was never installed and failed every
# night with exit 203. The push and its restore drill are removed.
# Re-install after changes:
#   sudo cp ops/vps/agentic-backup.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl reset-failed agentic-backup.service
[Unit]
Description=Agentic data/ nightly backup

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'mkdir -p /var/backups/agentic && tar -czf /var/backups/agentic/data-$(date +%%F).tar.gz -C /home/agentic/Agentic data $(cd /home/agentic/Agentic && ls -d data-lab 2>/dev/null) && find /var/backups/agentic -name "data-*.tar.gz" -mtime +14 -delete'
