# Copy to .env (gitignored) and fill in. NEVER commit .env.
#
# CONSTRAINT #4 (CLAUDE.md): PAPER_MODE=true is the default. Live trading requires a
# HUMAN to set BOTH of the variables below. The agent must never set either one,
# suggest setting them, or write code that sets them.
PAPER_MODE=true

# The second key. Required only when PAPER_MODE=false, and it must hold this phrase
# EXACTLY (case-sensitive):
#
#   LIVE_TRADING_CONFIRMED="I CONFIRM LIVE TRADING WITH REAL MONEY"
#
# If PAPER_MODE=false and this is missing or does not match, the process HARD-FAILS at
# startup. It never falls back to paper: believing you are live when you are not is
# worse than not starting.
LIVE_TRADING_CONFIRMED=

# --- Alpaca: equity + long options (paper first; same interface for live) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Kalshi: prediction-market sleeve (only after the equity leg proves out in paper) ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# --- Signal sources ---
X_BEARER_TOKEN=
QUIVER_API_KEY=
UNUSUAL_WHALES_API_KEY=
SEC_EDGAR_USER_AGENT=

# --- Research layer ---
ANTHROPIC_API_KEY=

# --- Runtime ---
DATA_DIR=./data
LOG_LEVEL=INFO
