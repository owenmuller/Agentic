# Copy to .env (gitignored) and fill in. NEVER commit .env.
#
# CONSTRAINT #4 (CLAUDE.md): PAPER_MODE=true is the default. Live trading requires a
# HUMAN to set PAPER_MODE=false in the environment. The agent must never set it,
# suggest setting it, or write code that sets it.
PAPER_MODE=true

# --- Alpaca: equity + long options (paper first; same interface for live) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Kalshi: prediction-market sleeve (only after the equity leg proves out in paper) ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# --- Signal sources ---
X_BEARER_TOKEN=
QUIVER_API_KEY=
UNUSUAL_WHALES_API_KEY=
SEC_EDGAR_USER_AGENT=

# --- Research layer ---
ANTHROPIC_API_KEY=

# --- Runtime ---
DATA_DIR=./data
LOG_LEVEL=INFO
